TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_WEBHOOK_SECRET=replace_with_random_letters_numbers_underscore_or_dash
APP_BASE_URL=https://your-service-name.onrender.com

# Use JDBC format. Example for Neon:
DB_URL=jdbc:postgresql://ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=replace_me

# Optional. Leave blank at first, send /whoami, then put one or more Telegram user IDs here.
# Use commas for multiple users, for example: 123456789,987654321
ALLOWED_TELEGRAM_USER_ID=

APP_TIME_ZONE=Asia/Phnom_Penh
APP_KHR_TO_USD_RATE=4100

# Scheduled reports use APP_TIME_ZONE. Cron expressions use six fields: second minute hour day month weekday.
DAILY_REPORT_ENABLED=true
DAILY_REPORT_CRON=0 55 23 * * *
MONTHLY_REPORT_ENABLED=true
MONTHLY_REPORT_CRON=0 59 23 L * *

PORT=8080
