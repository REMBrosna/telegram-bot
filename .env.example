TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_WEBHOOK_SECRET=replace_with_random_letters_numbers_underscore_or_dash
APP_BASE_URL=https://your-service-name.onrender.com

# Use JDBC format. Example for Neon:
DB_URL=jdbc:postgresql://ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=replace_me

# Optional. Leave blank at first, send /whoami, then put your Telegram user id here.
ALLOWED_TELEGRAM_USER_ID=

APP_TIME_ZONE=Asia/Phnom_Penh
PORT=8080
